# Before Yes settings. Copy this file to before-yes.toml (gitignored) and edit the copy.
#
# This file holds REFERENCES to keys, never key values. Keel refuses a literal
# secret here. Each [secrets.*] table names an env file and a variable inside it.
# The keys themselves stay in /home/nryn/work/before-yes/.env (mode 0600, gitignored).
# See docs/keys.md for where each key comes from.

# Where the server listens and where its data lives.
listen   = "127.0.0.1:8090"
data_dir = "data"
web_dir  = "web/build"

# live = false answers only from cached cards. Use it for judging week.
live = true

# App Store storefront whose reviews are read, and how many review pages.
country      = "us"
review_pages = 10

# How long a card is reused, and how long the sources for a title are reused.
card_max_age_hours     = 168
evidence_max_age_hours = 168

# Judge thinking switches, merged into the judge's request bodies. Top-level
# keys must stay above the first table header. The main pass turns thinking
# off, and the conflict pass turns it on. Confirmed against Token Factory at
# T2.1b on both roles: the same prompt reported 4 output tokens with
# enable_thinking false and about 180 with it true. reasoning.enabled did
# nothing on that host. build.nvidia.com takes this same switch. OpenRouter
# ignores it and takes reasoning = { enabled = false } instead, so enabling the
# OpenRouter tables below also means replacing these two lines with
#   judge_fast  = { reasoning = { enabled = false } }
#   judge_think = { reasoning = { enabled = true } }
judge_fast  = { chat_template_kwargs = { enable_thinking = false } }
judge_think = { chat_template_kwargs = { enable_thinking = true } }

# Reader: Nemotron 3 Nano on Token Factory. Reads review chunks and sources.
# Prices are dollars per million tokens. Thinking is on by default on this
# host and is billed as output: at T2.1b the same prompt reported 4 output
# tokens with chat_template_kwargs enable_thinking false against about 180
# with no switch at all. [reader.extra] below is merged into every reader
# request and turns it off. A call that wants thinking on overrides it per call.
[reader]
provider   = "tokenfactory"
base_url   = "https://api.tokenfactory.nebius.com/v1"
# Confirmed at T2.1b against GET /v1/models. The capitals are load-bearing:
# the all-lowercase spelling answers HTTP 404.
model      = "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
input_per_m  = 0.06
output_per_m = 0.24
# Raised from 4096 at T3.9: some reader replies hit 4096 and were cut. The
# cap is not part of a recorded request, so replays are unaffected; billing
# is by tokens actually used.
max_tokens   = 8192
# Confirmed at T2.1b: x-ratelimit-limit-requests reports 100 for this model,
# counted per model rather than per account. The host scales it with load.
per_minute   = 100

# The reader's thinking switch, confirmed live at T2.1b: 4 output tokens off,
# about 183 on, same prompt.
[reader.extra]
chat_template_kwargs = { enable_thinking = false }

# Judge: Nemotron 3 Super on Token Factory. Grades the areas on each card.
[judge]
provider   = "tokenfactory"
base_url   = "https://api.tokenfactory.nebius.com/v1"
# Confirmed at T2.1b against GET /v1/models.
model      = "nvidia/nemotron-3-super-120b-a12b"
input_per_m  = 0.30
output_per_m = 0.90
max_tokens   = 4096
# Confirmed at T2.1b: x-ratelimit-limit-requests reports 300 for this model,
# counted per model rather than per account. The host scales it with load.
per_minute   = 300

# Development alternative: build.nvidia.com (free). Uncomment to replace the
# [reader] and [judge] tables above, and point [secrets.reader] and
# [secrets.judge] below at var = "NVIDIA_KEY". Both ids are confirmed at T2.1b.
# The Nano id the catalogue lists, nvidia/nemotron-nano-3-30b-a3b, is listed but
# answers HTTP 404 ("Function ... Not found for account"), so the reader here is
# the Lightning 30B-A3B, not Nano. This host takes the same switch as Token
# Factory, chat_template_kwargs.enable_thinking (4 output tokens off, 308 on; 512 at the cap in the declared-switch check),
# so judge_fast and judge_think above stay as they are.
#
# [reader]
# provider   = "nvidia"
# base_url   = "https://integrate.api.nvidia.com/v1"
# model      = "nvidia/nemotron-3.5-lightning-30b-a3b"
# input_per_m  = 0
# output_per_m = 0
# max_tokens   = 4096
# per_minute   = 20
#
# [reader.extra]
# chat_template_kwargs = { enable_thinking = false }
#
# [judge]
# provider   = "nvidia"
# base_url   = "https://integrate.api.nvidia.com/v1"
# model      = "nvidia/nemotron-3-super-120b-a12b"
# input_per_m  = 0
# output_per_m = 0
# max_tokens   = 4096
# per_minute   = 20

# Development alternative: free OpenRouter stand-ins. Uncomment to replace the
# [reader] and [judge] tables above while developing. Do not use in the demo.
# The reader stand-in is NOT Nano. It is a different model.
# Replace the tables, do not add a second copy. Also point [secrets.reader] and
# [secrets.judge] below at var = "OPENROUTER_KEY", or the stand-ins get no key.
# Both ids are confirmed at T2.1b. This host ignores chat_template_kwargs and
# turns thinking on by default; its switch is reasoning.enabled false, and
# without it the reader's reply is all reasoning and no content (measured: 512
# output tokens, empty text). The [reader.extra] table below carries that
# switch; replace judge_fast and judge_think as described at the top of the
# file.
#
# [reader]
# provider   = "openrouter"
# base_url   = "https://openrouter.ai/api/v1"
# model      = "nvidia/nemotron-3.5-lightning:free"
# input_per_m  = 0
# output_per_m = 0
# max_tokens   = 4096
# per_minute   = 20
#
# [reader.extra]
# reasoning = { enabled = false }
#
# [judge]
# provider   = "openrouter"
# base_url   = "https://openrouter.ai/api/v1"
# model      = "nvidia/nemotron-3-super-120b-a12b:free"
# input_per_m  = 0
# output_per_m = 0
# max_tokens   = 4096
# per_minute   = 20

# Spend ceilings, with their reasons and arithmetic in docs/budget.md.
# model_usd is the lifetime Token Factory ceiling, 80% of the $25 credit; the
# remaining $5 is reserve. The model pool opens with cost.None (lifetime).
# tavily_credits_monthly is the Tavily ceiling, 900 of the 1,000 free credits a
# month. The tavily pool must open with cost.MonthlyUTC, or 900 becomes a
# lifetime ceiling.
# daily_fresh_checks is the judging-window cap on fresh checks per UTC day. It is
# the limit of the checks_daily pool (internal/spend, BeginCheck), which opens with
# cost.DailyUTC. The pipeline passes it when it opens the meter; no loader reads it yet.
[budget]
model_usd              = 20
tavily_credits_monthly = 900
daily_fresh_checks     = 5

# Key references. Each one names the env file, the variable inside it, and when to read it.
[secrets.reader]
source = "env_file"
path   = "/home/nryn/work/before-yes/.env"
var    = "NEBIUS_KEY"
read   = "at_use"

[secrets.judge]
source = "env_file"
path   = "/home/nryn/work/before-yes/.env"
var    = "NEBIUS_KEY"
read   = "at_use"

[secrets.tavily]
source = "env_file"
path   = "/home/nryn/work/before-yes/.env"
var    = "TAVILY_KEY"
read   = "at_use"

# Optional gate passcode. Uncomment when the gate is wired (T4.3). The variable
# name below is a placeholder. It is not in .env yet, and the user must add it
# to the env file before this reference will resolve.
# [gate.passcode]
# source = "env_file"
# path   = "/home/nryn/work/before-yes/.env"
# var    = "BEFORE_YES_PASSCODE"
# read   = "at_use"
