{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1927005665"}, "name":{"label":"juiii.298"}, "label":""}, "updated":{"label":"2026-05-29T10:02:03-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"1.6.15.1"}, "id":{"label":"14120181977"}, "title":{"label":"language"}, "content":{"label":"Thank you for creating this game. We Vietnamese all really enjoy it, but there's one thing I hope you'll add: please add Vietnamese language support for iOS players like us. We're not fluent in your language, and sometimes we have to exit and re-enter the game to look up words, which is inconvenient. We hope you'll add this. Thank you.🥰💗", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
