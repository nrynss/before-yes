{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id685161152"}, "name":{"label":"sir_kibble"}, "label":""}, "updated":{"label":"2025-07-12T19:19:14-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"1.6.15.0"}, "id":{"label":"12885109978"}, "title":{"label":"Ostrich egg shortage"}, "content":{"label":"I would give it 5 stars but I only found one ostrich egg in the Ginger Island Volcano cave in over 230 hours of gameplay. I really need ostriches on my farm. Please fix.\n\nAlso I have to mention that one of the wallpapers that I used on my farm is now missing from the catalog. That wallpaper is the grey brick wall.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
