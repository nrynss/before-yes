{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1094683176"}, "name":{"label":"CNthk"}, "label":""}, "updated":{"label":"2025-06-21T16:56:36-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"1.6.15.0"}, "id":{"label":"12802122402"}, "title":{"label":"Great game, too hard to fish"}, "content":{"label":"I love the game a lot, all my levels are high except fishing which is too hard in iOS app. When I tap or even try to hold down on the screen the fishing pole just pulls back up, and the fishing module never pops up. Hope it gets an update. Thank you.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
