{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id970942100"}, "name":{"label":"theParadox42"}, "label":""}, "updated":{"label":"2019-12-20T19:23:51-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.0"}, "id":{"label":"5298070441"}, "title":{"label":"Amazing game"}, "content":{"label":"I love this game just as much as my little brother does. The graphics are superb, the gameplay is progressive, the story intriguing, and the sound fits in perfectly. I agree that there should definitely be an AR mode for this, that would be awesome, though I do realize that adjusting touch controls accordingly might not flow as well as it does now.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1441636691&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
