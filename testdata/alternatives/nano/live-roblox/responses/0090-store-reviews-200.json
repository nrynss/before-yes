{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id38303202"}, "name":{"label":"Sunny-sweetie"}, "label":""}, "updated":{"label":"2025-09-19T21:05:47-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.6.15.0"}, "id":{"label":"13159679757"}, "title":{"label":"LOVE THIS GAME but…"}, "content":{"label":"I really love this game. But there’s one thing I hope the developers can fix. Sometimes when I play almost my entire screen goes black except for the top of my tool bar and how much gold and the time. So could you guys please fix this as soon as you can? Ok thank you bye!\n\nP.S, For anyone else besides the developers, download this game if you love adventure and farming!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
