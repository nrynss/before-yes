{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id100544467"}, "name":{"label":"Lmsmith114"}, "label":""}, "updated":{"label":"2020-09-13T17:45:16-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"1.0.1"}, "id":{"label":"6426635847"}, "title":{"label":"I wanted to love this"}, "content":{"label":"I really wanted to love this game but honestly it’s just hard to play. The controls are wonky & pieces are hard to get to go into place. You cant rotate the view in order to see what you would think you need to see. And anytime I try to move a piece the character jumps to that piece. Some issues need to be fixed. I think this could be a really great game", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1441636691&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
