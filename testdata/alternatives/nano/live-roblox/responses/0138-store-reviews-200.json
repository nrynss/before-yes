{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id120661838"}, "name":{"label":"Daniel the greatest"}, "label":""}, "updated":{"label":"2020-06-28T17:42:16-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"1.0.1"}, "id":{"label":"6133865893"}, "title":{"label":"Amazing game, graphics, concept; bad controls"}, "content":{"label":"Everything about this game is surprisingly terrific, except the controls. Love it!\n\nTo the developers; please issue a simple update with some options to the controls, hold to drop is a time consuming control that takes you away from the immersion, especially on levels where time matters.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1441636691&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
