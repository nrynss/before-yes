{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1674182372"}, "name":{"label":"我shaving"}, "label":""}, "updated":{"label":"2026-07-13T21:21:50-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.6.15.1"}, "id":{"label":"14300687402"}, "title":{"label":"Switching to a new device causing saves"}, "content":{"label":"It’s an amazing game but the game cannot load saves across different devices with the same apple account. One way I found that works across multiple(apple only) devices is to airdrop a world directly to another device and have that device drag the world folder into their stardew valley folder.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
