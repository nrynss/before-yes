{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1524519641"}, "name":{"label":"Leiliyia"}, "label":""}, "updated":{"label":"2025-07-20T20:02:46-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.6.15.0"}, "id":{"label":"12916847793"}, "title":{"label":"Found bugs on racoon quest"}, "content":{"label":"Hi,been playing stardew since from ps4 and to mobile.Love this game🫶🏻Just want to update I cant complete the racoon second quest.When I tried to put the jam the apps immediately close.I hope you guys can fix the bug soon👍🏻", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1406710800&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
